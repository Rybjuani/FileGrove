{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main window of FileGrove",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:tray:default",
    "core:menu:default",
    "core:event:default",
    "core:path:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:default",
    "autostart:default"
  ]
}
